# Indicadores API — environment configuration.
# PLACEHOLDERS ONLY. Never commit real secrets or credentials here.

# Required. Guards GET /indicadores and POST /cron/refresh via the X-API-Key header.
INDICADORES_SERVICE_API_KEY=replace-me-with-a-strong-random-key

# Source URLs (configurable for format-drift recovery). Supports {year} and
# {month} placeholders. The Previred PDF and SII circular URLs are published by
# those sources and change over time — set them explicitly before scraping.
PREVIRED_URL=
SII_CIRCULAR_URL=
# mindicador.cl is a stable public API; defaults to this if unset.
MINDICADOR_URL=https://mindicador.cl/api

# Alert target (webhook URL) for scrape/parse failures. Empty disables alerts.
ALERT_TARGET=

# HTTP port (default 3000).
PORT=3000
