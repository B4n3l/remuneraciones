# Indicadores API — environment configuration.
# PLACEHOLDERS ONLY. Never commit real secrets or credentials here.

# Required. Guards GET /indicadores and POST /cron/refresh via the X-API-Key header.
INDICADORES_SERVICE_API_KEY=replace-me-with-a-strong-random-key

# Source URLs (configurable for format-drift recovery). Filled by the scrapers in PR1b.
PREVIRED_URL=https://example.com/previred-placeholder
SII_CIRCULAR_URL=https://example.com/sii-placeholder
MINDICADOR_URL=https://example.com/mindicador-placeholder

# Alert target (webhook URL or email) for scrape/parse failures. Empty disables alerts.
ALERT_TARGET=

# HTTP port (default 3000).
PORT=3000
